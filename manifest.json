{
  "manifest_version": 3,
  "name": "Arini Companion",
  "version": "1.0.0",
  "description": "Replaces the new tab page with Arini's day counter. Click through to the control plane.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arini-newtab@arini.ai",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "icons/icon-128.png"
  }
}
